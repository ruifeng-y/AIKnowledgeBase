NODE_ENV=development

API_PORT=3001
WEB_PORT=3000

# PostgreSQL 16 + pgvector (local Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_knowledge_base
POSTGRES_USER=akb
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://akb:change_me@localhost:5432/ai_knowledge_base

# Redis 7 (local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible storage (local Docker)
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=ai-knowledge-base

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_me
S3_BUCKET=ai-knowledge-base

# Auth / JWT (dev-only placeholder; do not commit real secrets)
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000
