NODE_ENV=development

API_PORT=3001
WEB_PORT=3000

# PostgreSQL 16 + pgvector (local Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_knowledge_base
POSTGRES_USER=akb
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://akb:change_me@localhost:5432/ai_knowledge_base

# Redis 7 (local Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible storage (local Docker)
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=ai-knowledge-base

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change_me
S3_BUCKET=ai-knowledge-base

# Auth / JWT (dev-only placeholder; do not commit real secrets)
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000

# Document upload limits
DOCUMENT_MAX_FILE_SIZE_BYTES=20971520
DOCUMENT_ALLOWED_MIME_TYPES=text/plain,text/markdown,application/pdf,application/json,text/html

# Embedding foundation (mock defaults; production via config)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Canonical provider runtime (V0.5-B). Prefer *_ID names; legacy names above still work.
# EMBEDDING_PROVIDER_ID=mock
# EMBEDDING_MODEL_ID=mock-embedding-v1
# EMBEDDING_ENDPOINT=https://YOUR_EMBEDDING_HOST/v1
# EMBEDDING_API_KEY=YOUR_API_KEY
# EMBEDDING_TIMEOUT_MS=30000
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DIMENSIONS=384

# RERANKER_PROVIDER_ID=mock
# RERANKER_MODEL_ID=mock-reranker-v1
# RERANKER_ENDPOINT=https://YOUR_RERANKER_HOST/v1/rerank
# RERANKER_API_KEY=YOUR_API_KEY
# RERANKER_TIMEOUT_MS=30000
# RERANKER_MAX_RETRIES=3
# RERANKER_MAX_CANDIDATES=50

# LLM_PROVIDER_ID=mock
# LLM_MODEL_ID=mock-llm-v1
# LLM_ENDPOINT=https://YOUR_LLM_HOST/v1
# LLM_API_KEY=YOUR_API_KEY
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=3
# LLM_MAX_OUTPUT_TOKENS=1024

# Production + mock is rejected unless explicitly allowed:
# EVALUATION_MODE=mock
