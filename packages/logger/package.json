{
  "name": "@akb/logger",
  "version": "0.0.0",
  "private": true,
  "description": "Logger package skeleton (V0.4-A: no platform integration)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
